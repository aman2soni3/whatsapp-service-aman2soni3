# OpenWA Microservice Environment Variables
# Copy this to .env and fill in the values

# Port for this service
PORT=3001

# Shared secret key (must match WHATSAPP_MICROSERVICE_KEY in Portal .env)
SERVICE_SECRET_KEY=ptwa-wa-secret-change-this-in-production

# PTWA Portal URL (for document generation callbacks)
PORTAL_URL=https://admin.ptwaindia.org

# Session storage path
SESSION_DATA_PATH=./wa-session

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Anti-ban settings (overrides DB if set)
DAILY_MSG_LIMIT=150
MIN_DELAY_MS=5000
MAX_DELAY_MS=30000

